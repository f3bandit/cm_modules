; SS1 Link settings. Copy to ss1-link.ini next to ss1-link.exe. Everything is optional.

; auto = SSH first when the SS1 is on the network (host= below), the dock's debug port otherwise. The boot log and reboots always use the debug port. Or: serial, ssh
transport=auto

; auto finds the dock's USB serial port by asking it. Or name it: COM5 (Windows), /dev/ttyUSB0 (Linux)
port=auto
baud=115200

; MiSTer login on the serial console (stock MiSTer: root / 1)
user=root
password=1

; SSH: the SS1's address on your network (Console Mode: Settings shows it). Unset: debug port only.
;host=192.168.1.50
ssh_user=root
ssh_password=1

; everything the console prints is appended here (default: ss1-link.log next to the program)
;log=C:\ss1-link\ss1-link.log
