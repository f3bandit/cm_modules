#include <winver.h>
1 ICON "../assets/app.ico"
1 24 "cm_win.manifest"
VS_VERSION_INFO VERSIONINFO
FILEVERSION 0,1,4,0
PRODUCTVERSION 0,1,4,0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "f3bandit"
      VALUE "FileDescription", "Console Mode for Windows"
      VALUE "FileVersion", "0.1.4"
      VALUE "LegalCopyright", "(C) 2026 f3bandit, GPL-3.0-or-later"
      VALUE "ProductName", "Console Mode"
      VALUE "ProductVersion", "0.1.4"
      VALUE "OriginalFilename", "cm_win.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
